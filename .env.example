# ============================================================
# LOTA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commit o arquivo .env — apenas o .env.example
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# ─── Evolution API (WhatsApp) ─────────────────────────────────
# URL do servidor onde a Evolution API está instalada
# Ex: https://evolution-api.railway.app ou http://SEU_IP:8080
VITE_EVOLUTION_API_URL=https://sua-evolution-api.com
VITE_EVOLUTION_API_KEY=sua-api-key-aqui

# ─── Opcional: Resend (email) ─────────────────────────────────
# VITE_RESEND_API_KEY=re_xxxx
